# Copy to .env (never commit .env). Every value is optional for local development.

# Port the API listens on
PORT=3000

# Public address of the web app. Used for the link inside confirmation emails.
APP_URL=http://localhost:5173

# Set to true when served over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# Behind a reverse proxy? Number of proxy hops (e.g. 1) so rate limits see real client IPs
# TRUST_PROXY=1

# Google sign-in (button stays hidden until this is set). Web client id from Google Cloud Console;
# add your app origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# No client secret and no redirect URIs are needed.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Email: leave SMTP_HOST empty to use "preview" mode (messages are written as
# .html/.txt files into pm-backend/data/mail-preview and the link is returned to the app).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ChainBoard <no-reply@example.com>
